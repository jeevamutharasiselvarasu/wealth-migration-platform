        {"name": "sleeve_id", "type": "string", "required": true, "maps_to": "Sleeve.sleeve_id"},
        {"name": "model_code", "type": "string", "required": true, "maps_to": "Model.model_code"},
        {"name": "target_pct", "type": "decimal", "required": true, "maps_to": "Sleeve.target_weight"}
      ]
    }
  ]
}