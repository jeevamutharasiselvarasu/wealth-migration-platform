# Settings for the XODUS platform in Azure Container Apps. Copy to deploy/azure/app.settings.env (git-ignored), fill in, then run
# deploy/azure/deploy_container_app.ps1. Every line becomes a Container Apps secret referenced by an environment variable.

# The platform's own tables in the XODUS database (schema xodus_app; user from deploy/xodus/01_app_schema.sql). URL-encode the password.
DATABASE_URL=mssql://xodus_app_user:<password>@<server>.database.windows.net:1433/<XODUS database>

# The first Platform Admin (registers at /register). Demo sign-in must stay off on a public address.
XODUS_BOOTSTRAP_ADMIN_EMAIL=<admin email>
XODUS_SEED_DEMO=0
XODUS_DEMO_MODE=false

# Data lake (raw/, sample-raw/, stage/, curated/).
AZURE_BLOB_CONNECTION_STRING=<storage account connection string>
AZURE_BLOB_SOURCE_CONTAINER=xodus-lake

# Data Factory and the service principal the platform uses to start runs and read their status.
AZURE_SUBSCRIPTION_ID=<subscription id>
AZURE_RESOURCE_GROUP=<resource group of the factory>
ADF_FACTORY_NAME=adf-amp-xodus
AZURE_STORAGE_ACCOUNT=<storage account name>
AZURE_CLIENT_SECRET=<service principal secret>

# GitHub (pull requests for the pipeline packages) and the SQL login of the target and live database connections. The password
# variable's name must match the one saved on the Target database and Live database pages (SQL_TARGET_PASSWORD today).
GITHUB_ADF_TOKEN=<token>
SQL_TARGET_USERNAME=<login>
SQL_TARGET_PASSWORD=<password>

# Optional: Confluence as a knowledge source.
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_ALLOWED_HOSTS=
