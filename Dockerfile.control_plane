FROM python:3.11-slim

WORKDIR /app

# Trust a company root CA (TLS inspection) when one is placed in certs/ as *.crt. With none present nothing changes.
COPY certs/ /tmp/xodus-certs/
RUN find /tmp/xodus-certs -name '*.crt' -exec cp {} /usr/local/share/ca-certificates/ \; && update-ca-certificates && rm -rf /tmp/xodus-certs

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Optional semantic search: build with  --build-arg EMBEDDING_MODEL=BAAI/bge-small-en-v1.5  to install fastembed (ONNX, CPU) and fetch the model into the image
# now, so the running container needs no internet access. Without the argument the platform uses its built-in hashing embedder.
ARG EMBEDDING_MODEL=""
ENV FASTEMBED_CACHE_PATH=/opt/embedding-models
RUN if [ -n "$EMBEDDING_MODEL" ]; then pip install --no-cache-dir "fastembed>=0.3"     && python -c "import os; from fastembed import TextEmbedding; TextEmbedding(model_name=os.environ['EMBEDDING_MODEL'])" ; fi
ENV XODUS_EMBEDDING_MODEL=$EMBEDDING_MODEL

# Python clients (httpx) read the system bundle, which now includes the company root CA.
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

COPY . .

EXPOSE 8000

ENV PYTHONUNBUFFERED=1
ENV PORT=8000

CMD ["sh", "docker_start.sh"]